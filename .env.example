# Copie esse arquivo pra ".env" (que já está no .gitignore) e preencha com
# a connection string do projeto Supabase compartilhado.
# Pega em: Supabase -> Project Settings -> Database -> Connection string -> URI
# (usa a "Transaction pooler", porta 6543, pra funcionar de qualquer rede)
DATABASE_URL=postgresql://postgres.xxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
